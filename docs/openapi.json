    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "Requires a current bearer token. . Students can access only their own loans.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked bearer token."
          },
          "403": {
            "description": "The authenticated account does not have permission."
          }
        }
      }
    },
    "/api/auth/logout": {
